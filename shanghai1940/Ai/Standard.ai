标准：
1_int buyLandExpect=30;    //越小，越喜欢买土地
2_int buyCompanyExpect=30;  //越小，越喜欢买企业
3_int keepCashExpect=1000;   //一般情况下希望保留的现金数
4_int keepCashDiff=200	//越小，进入银行越频繁，例如计算出要保留1200而实际为1100，1200-1100《200，因此不进入银行
5_int buildHouseExpect=45;  //越小，越喜欢建房
6_int mortgageExpect=50;  //越小，越喜欢抵押
7_int	unmortgageExpect=50;//越小，越喜欢赎回
8_int removeExpect=40;	//越小，越喜欢拆房
9_int intendToAddMuchMoney=50;  //越大，在拍卖中越喜欢
10_int acceptableDiffenceInTrade=-20;  //以在交易中可以接受的				//价值差别，以百分数表示
11_int tradeCycle=1;		//寻求交易的平均周期（次）
12_int maxInvestment=10;	//总资产*maxInvestment/100 为继续进行投资的资金下限，
						//如果资金少于此数目，不再投资

